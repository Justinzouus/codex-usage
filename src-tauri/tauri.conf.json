{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Usage",
  "version": "1.0.0",
  "identifier": "app.codexusage.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "widget",
        "title": "Codex Usage",
        "width": 288,
        "height": 288,
        "minWidth": 288,
        "minHeight": 288,
        "maxWidth": 288,
        "maxHeight": 288,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Codex quota at a glance",
    "longDescription": "A local-first macOS menu bar quota monitor and local usage analytics dashboard for Codex.",
    "copyright": "Copyright Codex Usage contributors; based on Quota Float",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
